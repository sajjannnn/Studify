generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Summary {
  id          String   @id @default(cuid())
  documentId  String
  userId      String
  userName    String
  prompt      String
  content     String   @db.Text
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
}
